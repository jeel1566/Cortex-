# LLM Provider: "azure" or "ollama"
LLM_PROVIDER="ollama"

# Azure AI Foundry / Kimi K2.5 Configuration
AZURE_ENDPOINT="YOUR_AZURE_ENDPOINT"
AZURE_API_KEY="YOUR_AZURE_API_KEY"
AZURE_MODEL_NAME="Kimi-K2.5"

# Ollama Configuration (only used if LLM_PROVIDER="ollama")
OLLAMA_ENDPOINT="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="llama3"
